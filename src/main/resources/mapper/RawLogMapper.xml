<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mine.clashmon.mapper.RawLogMapper">
<!--
    List<RawLog> listRawLogs();
    int insertRawLog(RawLog rawLog);
    int deleteRawLog(Long id);
    -->
    
    <resultMap id="rawLogMap" type="com.mine.clashmon.pojo.RawLog">
        <id column="url_id" property="urlId"/>
        <id column="ts" property="ts"/>
        <result column="used_upload" property="usedUpload"/>
        <result column="used_download" property="usedDownload"/>
        <result column="total" property="total"/>
        <association property="url" javaType="com.mine.clashmon.pojo.Url">
            <id column="id" property="id"/>
            <result column="url" property="url"/>
            <result column="description" property="description"/>
            <result column="created_at" property="createdAt"/>
            <result column="modified_at" property="modifiedAt"/>
        </association>
    </resultMap>

    <select id="listRawLogs" resultMap="rawLogMap">
        SELECT *
        FROM raw_log
        INNER JOIN url ON raw_log.url_id = url.id
        WHERE raw_log.ts >= DATE_SUB(NOW(3), INTERVAL 1 MONTH) AND raw_log.url_id = #{id}
    </select>

    <insert id="insertRawLog" parameterType="com.mine.clashmon.pojo.RawLog">
        INSERT INTO raw_log (url_id, used_upload, used_download, total) VALUES (#{urlId}, #{usedUpload}, #{usedDownload}, #{total})
    </insert>
    <delete id="deleteRawLog" parameterType="com.mine.clashmon.pojo.RawLog">
        DELETE FROM raw_log WHERE id = #{id}
    </delete>
<!--

    RawLog getLastRawLog(Long id);
-->
    <select id="getLastRawLog" resultType="com.mine.clashmon.pojo.RawLog">
        SELECT *
        FROM raw_log
        WHERE url_id = #{id}
        ORDER BY ts DESC
        LIMIT 1
    </select>
</mapper>